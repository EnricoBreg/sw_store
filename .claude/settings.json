{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(bin/rails test:*)",
      "Bash(bin/rails routes:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bin/brakeman:*)",
      "Bash(bundle exec brakeman:*)",
      "Bash(bin/bundler-audit:*)",
      "Bash(npx ng test:*)",
      "Bash(npx ng build:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run i18n:*)"
    ]
  }
}
